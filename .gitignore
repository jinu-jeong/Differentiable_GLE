# data: raw all-atom data are downloaded (see README); processed data are made from them by the scripts.
# Only the small processed inputs of the bulk systems are tracked, so that the bulk runs need no download.
data/raw/
data/processed/*
!data/processed/H2O/
!data/processed/CO2/

# trained models and analyses
results/
*.xyz
!forcefields/**/*.xyz
*.out

# manuscript and private notes (not part of the code release)
paper/
research.md

# python / tools
__pycache__/
*.pyc
.claude/
.vscode/
